{
  "schema_version": "1.0",
  "run_id": "engine-contract-smoke",
  "description": "Godot engine accuracy/contracts only (TurnSearch, commits, rejects, seeds). No LLM.",
  "case_globs": ["*.json"],
  "splits": ["blocking", "dev"],
  "eval_lanes": ["engine"],
  "profiles": ["baseline-argmax"],
  "repeats": 1,
  "layers": ["contract", "validity", "gold", "trajectory", "cost"],
  "transforms": ["identity"],
  "include_fidelity_limited": true,
  "mode": "engine_backed"
}
